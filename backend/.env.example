# Netraze FastAPI Backend Environment Configuration
PROJECT_NAME="Netraze Backend"
API_V1_STR="/api/v1"
DEBUG=true

# Database Connection (Psycopg 3 / PostgreSQL)
# Format: postgresql+psycopg://user:password@host:port/dbname
DATABASE_URL="postgresql+psycopg://netraze_user:netraze_password@localhost:5432/netraze_db"

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:8000", "http://127.0.0.1:8000"]
